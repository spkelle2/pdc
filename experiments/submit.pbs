#!/bin/bash
#PBS -j n   # keep stdout (.out) and stderr (.err) separate

set -u

cd /home/sek519/warm_starting/pdc/experiments

source /home/sek519/miniconda/bin/activate
conda activate pdc

../Release/pdc \
  "${INPUT_FOLDER}" \
  "${OUTPUT_FILE}" \
  "${MAX_TIME}" \
  "${GENERATOR}" \
  "${TERMS}" \
  "${MIP_SOLVER}" \
  "${PROVIDE_PRIMAL_BOUND}" \
  "${SEED_INDEX}" \
  "${TIGHTEN_DISJUNCTION}" \
  "${TIGHTEN_MATRIX_PERTURBATION}" \
  "${TIGHTEN_INFEASIBLE_TERM}" \
  "${TIGHTEN_INFEASIBLE_BASIS}" \
  "${DISJUNCTIVE_WARM_START}"

rc=$?

# Only report failures to stderr
if [ "$rc" -ne 0 ]; then
  if [ "$rc" -ge 128 ]; then
    sig=$((rc - 128))
    case "$sig" in
      6)
        echo "FAILED: SIGABRT (6)" >&2
        ;;
      9)
        echo "FAILED: SIGKILL (9)" >&2
        ;;
      11)
        echo "FAILED: SIGSEGV (11)" >&2
        ;;
      15)
        echo "FAILED: SIGTERM (15)" >&2
        ;;
      *)
        echo "FAILED: SIGNAL=$sig" >&2
        ;;
    esac
  else
    echo "FAILED: EXIT_CODE=$rc" >&2
  fi
fi

